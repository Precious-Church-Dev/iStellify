{
  "name": "istellify",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "seed:demo": "node scripts/seed-demo.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "exceljs": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  },
  "type": "module",
  "overrides": {
    "uuid": "11.1.1"
  }
}
