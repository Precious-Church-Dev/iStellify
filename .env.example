DATABASE_URL=postgresql://postgres:postgres@localhost:5432/istellify
APP_URL=http://localhost:3000
# Set a unique random value of at least 32 characters before first setup.
SETUP_SECRET=
# PostgreSQL SSL: set true only when your provider requires SSL.
DATABASE_SSL=false

